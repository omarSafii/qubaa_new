DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DATABASE_URL=postgresql://qubaa_user:replace-password@db.example.com:5432/qubaa

# Optional when your frontend is on another origin.
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com

# Optional overrides.
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SESSION_COOKIE_AGE=2592000
DJANGO_SESSION_SAVE_EVERY_REQUEST=True
DJANGO_STATIC_ROOT=/srv/qubaa/staticfiles
DJANGO_MEDIA_ROOT=/srv/qubaa/media

# Optional Gunicorn tuning.
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=120
